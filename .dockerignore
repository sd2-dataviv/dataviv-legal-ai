# Keep the build context small and secrets out of the image.
.git
.venv
.venv-*
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.egg-info
.coverage
htmlcov

# secrets: backend/.env is passed at run time (docker-compose env_file), never baked in
**/.env
**/.env.*
!backend/.env.example

frontend/node_modules
frontend/dist
frontend/tsconfig.tsbuildinfo

var
logs
docs
infra
backend/tests
backend/evals
scripts/windows
*.bat
*.ps1
requirements_report.txt
Dockerfile
docker-compose*.yml
