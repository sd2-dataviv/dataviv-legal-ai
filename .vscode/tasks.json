{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1 · Start database",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml up -d postgres",
      "problemMatcher": []
    },
    {
      "label": "2 · Migrate database",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m alembic upgrade head",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "3 · Seed dev data",
      "type": "shell",
      "command": "${command:python.interpreterPath} scripts/seed_dev.py",
      "problemMatcher": []
    },
    {
      "label": "Run API",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint + format check",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m ruff check . && ${command:python.interpreterPath} -m ruff format --check .",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Type check",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m mypy app",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
