# Copy to backend/.env for local runs. Never commit real secrets.
DATAVIV_ENV=dev
DATAVIV_DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_only@localhost:5432/dataviv
DATAVIV_DATABASE_OWNER_URL=postgresql+asyncpg://dataviv:dataviv_dev_only@localhost:5432/dataviv
DATAVIV_JWT_SECRET=change-me-dev-only-secret-32-bytes-min
DATAVIV_LLM_BACKEND=fake                           # setup.ps1 switches this to groq when a key is present

# Assistant (Step 2): model provider. Paste your own key; it is never logged or printed.
# GROQ_API_KEY=gsk_...
# DATAVIV_LLM_DEFAULT_MODEL=openai/gpt-oss-120b
# DATAVIV_LLM_REASONING_EFFORT=low                 # low | medium | high
# DATAVIV_ASSISTANT_VERIFIER=lexical                # lexical (free) | model (one extra call per answer)

# Vault (Step 1)
# DATAVIV_STORAGE_DIR=C:\\dataviv\\storage      # default: <repo>/var/storage
DATAVIV_MAX_UPLOAD_MB=50
# DATAVIV_OCR_URL=http://localhost:8100            # Dataviv OCR service; unset = scans wait as "OCR pending"
DATAVIV_RUN_WORKER_IN_API=true                     # dev: worker runs inside the API process

# Semantic search (Step 1c, ADR-019). Off by default: search is keyword-only until BOTH are set.
# DATAVIV_EMBEDDINGS_BACKEND=local                  # local (bge-m3 in-process; setup.sh --semantic) | http | fake
# DATAVIV_EMBEDDINGS_DEVICE=cpu                     # local backend: cpu | cuda
# DATAVIV_EMBEDDINGS_URL=http://gpu-vm:8080/v1      # http backend: TEI or any OpenAI-compatible /embeddings
# DATAVIV_EMBEDDINGS_MODEL=BAAI/bge-m3
# DATAVIV_VECTOR_STORE=qdrant                       # qdrant (bash scripts/linux/qdrant.sh) | memory | none
# DATAVIV_QDRANT_URL=http://127.0.0.1:6333
# DATAVIV_SEMANTIC_MIN_SCORE=0.5                    # passages found only by meaning must be this similar

# E-signature (Step 2e, ADR-021). none = off; fake = test mode (no e-mail, signing simulated in the console);
# docusign = real. Setup steps: docs/steps/step2e-esignature.md. Keep the private key OUTSIDE the repository.
# DATAVIV_ESIGN_BACKEND=fake
# DATAVIV_DOCUSIGN_INTEGRATION_KEY=
# DATAVIV_DOCUSIGN_USER_ID=
# DATAVIV_DOCUSIGN_PRIVATE_KEY_PATH=/home/you/.dataviv/docusign_private.key
# DATAVIV_DOCUSIGN_AUTH_SERVER=account-d.docusign.com
# DATAVIV_DOCUSIGN_ACCOUNT_ID=
# DATAVIV_DOCUSIGN_WEBHOOK_URL=https://your-host/v1/esign/docusign/connect
# DATAVIV_DOCUSIGN_CONNECT_SECRET=
