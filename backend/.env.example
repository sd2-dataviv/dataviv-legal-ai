# Copy to backend/.env for local runs. Never commit real secrets.
DATAVIV_ENV=dev
DATAVIV_DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_only@localhost:5432/dataviv
DATAVIV_DATABASE_OWNER_URL=postgresql+asyncpg://dataviv:dataviv_dev_only@localhost:5432/dataviv
DATAVIV_JWT_SECRET=change-me-dev-only-secret-32-bytes-min
DATAVIV_LLM_BACKEND=fake
